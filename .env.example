# Required for GitHub Issues/Projects integration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_PROJECT_ID=
GITHUB_REPO=eminogrande/nuri-feedback-board
NEXT_PUBLIC_GITHUB_REPO=eminogrande/nuri-feedback-board
NEXT_PUBLIC_GITHUB_PROJECT_URL=https://github.com/users/eminogrande/projects/1

# Required for Nuri passkey auth
AUTH_SECRET= # random 32+ byte string, e.g. openssl rand -base64 32
NURI_PASSKEY_ORIGIN=https://feedback.nuri.com
NURI_PASSKEY_STORE_PATH= # optional path to trusted credential registry JSON

# Required for Arkade Bitcoin payouts
ARKADE_MNEMONIC= # 12/24 word BIP39 seed, funded on testnet/mainnet
ARKADE_SERVER_URL=https://arkade.computer

# Optional: restrict payouts to testnet until approved
# PAYOUT_ENABLED=false
